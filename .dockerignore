.env
.env.*
!.env.example
__pycache__/
*.py[cod]
.git/
.gitignore
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
tests/
docs/
deploy/
scripts/
docker-compose.yml
Dockerfile
Makefile
