# EveryCRED Audit Log Service - configuration template
#
#   cp .env.example .env
#
# Values marked REQUIRED have no default: the service refuses to start without
# them rather than fall back to something guessable (SOC 2 CC6.1). Nothing in
# this file is a real credential.

# ---------------------------------------------------------------------------
# Service
# ---------------------------------------------------------------------------
ENVIRONMENT=local                 # local | dev | staging | prod
SERVER_HOST=0.0.0.0
SERVER_PORT=8020
DEBUG=false

# Schema endpoints (/docs, /redoc, /openapi.json). Forced off in prod: the API
# shape describes the whole platform's activity model.
ENABLE_DOCS=true

# Comma-separated. MUST list the audit reader UI origin explicitly - the main
# backend's broad allow_origins=["*"] is deliberately not copied here, because
# these endpoints return cross-user personal data. A "*" is rejected in prod.
CORS_ALLOW_ORIGINS=http://localhost:4200

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# The service API key is the ONLY credential this service accepts. There is no
# user-token path: callers send `x-api-key` plus `x-audit-user-uuid` to name the
# user the call acts for.
#
# A valid key carries every audit scope, including audit:erase (crypto-shredding
# a data subject's personal data) and audit:cross_user. Treat it as a
# high-value secret: distinct per environment, rotated on a schedule, and never
# shared with a component that only needs to write events.
#
# REQUIRED in prod. Comma-separated, so a key can be rotated with an overlap
# window: add the new key, redeploy every emitter, then drop the old one.
# Generate with: openssl rand -hex 32
SERVICE_API_KEYS=dev-service-key-please-replace

# --- Issued keys (the ingest plane) ----------------------------------------
# The keys above are the ADMIN plane: rotated by deploy, every scope, and the
# only credential that may mint or revoke others. Per-emitter keys are issued
# through POST /v1/audit/admin/api-keys instead - each bound to one user and
# one emitting domain, write-only by default, revocable in seconds.
#
# API_KEY_PEPPER is what stops a database dump from being enough to test
# candidate keys offline: the store holds a peppered digest, never a secret.
# No default and no fallback. Unset, the service still runs and still accepts
# SERVICE_API_KEYS - it simply refuses to mint keys, rather than protecting
# them with a value anyone could guess.
# Generate with: openssl rand -hex 32
API_KEY_PEPPER=

# How long a verified key stays in the process cache. Also the worst-case delay
# before a revocation reaches an already-warm replica.
API_KEY_CACHE_TTL_SECONDS=60

# Lifetime of an issued key when the caller does not ask for a shorter one.
API_KEY_DEFAULT_EXPIRY_DAYS=365

# ---------------------------------------------------------------------------
# Elasticsearch
# ---------------------------------------------------------------------------
# Must be https in prod (startup rejects http there).
ES_HOSTS=http://localhost:9200

# Prefer an API key over basic auth: scoped, revocable, no reusable password on
# the wire. See elasticsearch/audit-service-role.json for the least-privilege
# role to attach. Set ES_API_KEY *or* ES_USERNAME + ES_PASSWORD.
# ES_API_KEY=
ES_USERNAME=elastic
ES_PASSWORD=changeme
# ES_CA_CERT_PATH=/etc/ssl/certs/es-ca.crt
ES_VERIFY_CERTS=true
ES_REQUEST_TIMEOUT=20
ES_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Index topology
# ---------------------------------------------------------------------------
INDEX_PREFIX=audit
SHARED_DATA_STREAM=audit-shared

# Users promoted to their own data stream. Comma-separated user UUIDs.
# Provision the stream first via POST /v1/audit/admin/users/{id}/dedicate,
# then add the id here and restart. Promotion is non-destructive: reads still
# cover the shared stream, so pre-promotion history stays visible.
DEDICATED_USERS=

ILM_POLICY_NAME=audit-retention
# 2190 days = 6 years (HIPAA 164.316(b)(2)(i)). This is the regulatory MAXIMUM
# retention, not the erasure mechanism - erasure is crypto-shredding, which
# leaves the record in place.
RETENTION_DAYS=2190
ROLLOVER_MAX_PRIMARY_SHARD_SIZE=50gb
ROLLOVER_MAX_AGE=30d
SHARED_SHARD_COUNT=3
DEDICATED_SHARD_COUNT=1
# Set to 0 for a single-node development cluster, >=1 in production.
INDEX_REPLICAS=1

# ---------------------------------------------------------------------------
# Query guardrails
# ---------------------------------------------------------------------------
MAX_PAGE_SIZE=200
DEFAULT_PAGE_SIZE=50
TOTAL_HITS_CAP=10000
# Refuses a wider window. An unbounded audit query is a six-year scan.
MAX_QUERY_WINDOW_DAYS=400
# Window used when a search names neither `start` nor `end`. 1 keeps a careless
# "show me everything" cheap; raise it when a console lists recent activity
# without asking the user for dates. Clamped to MAX_QUERY_WINDOW_DAYS.
DEFAULT_QUERY_WINDOW_DAYS=1
SEARCH_TIMEOUT=20s

# ---------------------------------------------------------------------------
# Redis ingest buffer
# ---------------------------------------------------------------------------
# Redis MUST run with `appendonly yes` and `appendfsync everysec`. Without AOF
# it is a buffer rather than a durable queue and the no-lost-events guarantee
# does not hold. Also set `maxmemory-policy noeviction` so memory pressure
# rejects writes instead of silently discarding queued audit events.
REDIS_URL=redis://localhost:6379/0
STREAM_KEY_PREFIX=audit:stream
STREAM_CONSUMER_GROUP=audit-writers
# Hash chains are per (user, partition), and a user is pinned to one
# partition. Changing this after go-live re-partitions users and starts new
# chains for them - plan it as a migration, not a config tweak.
STREAM_PARTITIONS=8
STREAM_MAX_LEN=1000000
WORKER_BATCH_SIZE=500
WORKER_BLOCK_MS=2000
WORKER_MAX_DELIVERY_ATTEMPTS=5

# ---------------------------------------------------------------------------
# S3 WORM archive
# ---------------------------------------------------------------------------
ARCHIVE_ENABLED=true
# The bucket MUST have been created with Object Lock enabled - it cannot be
# turned on afterwards. Startup logs `worm_archive_misconfigured` if it is
# missing, which means "immutable" segments are in fact deletable.
ARCHIVE_BUCKET=everycred-audit-archive-local
ARCHIVE_PREFIX=audit
AWS_REGION=ap-south-1

# Local MinIO. Leave unset in production to use real S3.
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123

# COMPLIANCE cannot be shortened or removed by any principal including the
# account root - that is what makes the archive genuine WORM evidence.
# GOVERNANCE is bypassable with a special permission, so prod requires COMPLIANCE.
OBJECT_LOCK_MODE=COMPLIANCE
OBJECT_LOCK_RETAIN_DAYS=2190
ARCHIVE_SEGMENT_MAX_EVENTS=5000
ARCHIVE_SEGMENT_MAX_SECONDS=300
# ARCHIVE_KMS_KEY_ID=arn:aws:kms:ap-south-1:...:key/...

# ---------------------------------------------------------------------------
# PII encryption / crypto-shredding
# ---------------------------------------------------------------------------
# REQUIRED. Generate with: uv run audit-service generate-kek
#
# Losing this key makes every encrypted field in the audit log permanently
# unreadable - there is no recovery path, by design. Store it in the secret
# manager, back it up, and never commit it.
PII_MASTER_KEK=

PII_KEK_VERSION=1
# Set false ONLY for a deployment with no personal data in scope.
PII_ENCRYPTION_ENABLED=true

# ---------------------------------------------------------------------------
# Rate limits
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
# Reads are the sensitive surface, so the ceiling is low.
READ_RATE_LIMIT_PER_MINUTE=120
# Ingest is trusted machine traffic, so the ceiling is high. Set it above peak
# platform activity: throttling ingest means dropping audit evidence.
INGEST_RATE_LIMIT_PER_MINUTE=20000
MAX_REQUEST_BODY_BYTES=5242880
MAX_INGEST_BATCH_SIZE=500

# ---------------------------------------------------------------------------
# Clock skew
# ---------------------------------------------------------------------------
# Tolerance between an emitter's claimed `timestamp` and receipt time before an
# event is marked `labels.clock_skew_suspect`. The event is always kept and its
# timestamp is never rewritten - a wrong clock is annotated, not corrected.
#
# This detects an unsynchronised emitter; it does not fix one. Every host that
# emits audit events must run NTP, or the chronology of an incident cannot be
# reconstructed no matter what this service records.
MAX_CLOCK_SKEW_SECONDS=300
